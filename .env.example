# Postgres connection. Matches docker-compose.yml.
DATABASE_URL=postgres://getstabilized:getstabilized@localhost:5432/getstabilized

# Which listing sources the worker runs, comma separated.
#   sample   = fixture listings in apps/worker/fixtures (works offline)
#   demo     = invents 1 or 2 new listings per run so you can watch live updates
#   rentcast = real listings from the RentCast API (needs RENTCAST_API_KEY)
LISTING_SOURCES=sample,demo

# Minutes between worker runs in --watch mode.
INGEST_INTERVAL_MINUTES=5

# https://www.rentcast.io/api  (free plan: 50 requests a month; extra requests are billed)
RENTCAST_API_KEY=
# The worker never makes more than RENTCAST_MONTHLY_LIMIT requests in a calendar month,
# and fetches each city at most once every RENTCAST_HOURS_BETWEEN hours.
RENTCAST_CITIES=sf
RENTCAST_MONTHLY_LIMIT=45
RENTCAST_HOURS_BETWEEN=24
RENTCAST_PAGES_PER_RUN=1

# Optional Socrata app token for DataSF. Raises rate limits.
# https://data.sfgov.org/profile/edit/developer_settings
DATASF_APP_TOKEN=
